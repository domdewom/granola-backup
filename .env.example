# Paste the full JSON contents from:
# ~/Library/Application Support/Granola/supabase.json
GRANOLA_SUPABASE_JSON='{"workos_tokens":"{\"access_token\":\"...\",\"refresh_token\":\"...\",\"client_id\":\"client_GranolaMac\"}"}'

# Optional
# BACKUP_WORKSPACE_ID='your-workspace-id'
# FULL_EXPORT='true'
# ALLOW_LARGE_DROP='true'

# Progress display (local only by default)
# auto: rich spinner in local TTY, quiet in GitHub Actions
# rich: force rich output
# plain: plain text progress lines
# off: disable progress output
# PROGRESS_MODE='auto'
# PROGRESS_LOG_EVERY='25'
